        "description": "Body for section 2 of disclosure"
    },
    "disclosureSection3Header": "Data retention",
    "@disclosureSection3Header": {
        "description": "Header for section 3 of disclosure"
    },
    "disclosureSection3Body": "Audio is not persisted after it has been transcribed — it is processed in transit and discarded. Transcripts and session summaries are kept only for the duration of your current session.",
